if(NOT DEFINED WEB_ROOT OR NOT DEFINED OUTPUT_RC OR NOT DEFINED OUTPUT_HEADER)
    message(FATAL_ERROR "WEB_ROOT, OUTPUT_RC, and OUTPUT_HEADER are required")
endif()

set(resource_entries "")
set(header "// Generated by embed_web.cmake. Do not edit.\n")
string(APPEND header "#pragma once\n\n")
string(APPEND header "#include <vector>\n\n")
string(APPEND header "#include <kasumi/platform/ksm_win32_resource_provider.h>\n\n")
string(APPEND header "namespace kasumi_app::embedded {\n\n")
string(APPEND header "inline std::vector<KSMWin32ResourceDescriptor> Resources() {\n")
string(APPEND header "    return {\n")

set(index 1)
foreach(relative_path IN LISTS FILES)
    file(TO_CMAKE_PATH "${WEB_ROOT}/${relative_path}" absolute_path)
    get_filename_component(extension "${relative_path}" EXT)
    string(TOLOWER "${extension}" extension)
    if(extension STREQUAL ".html")
        set(mime "text/html; charset=utf-8")
    elseif(extension STREQUAL ".css")
        set(mime "text/css; charset=utf-8")
    elseif(extension STREQUAL ".js" OR extension STREQUAL ".mjs")
        set(mime "text/javascript; charset=utf-8")
    elseif(extension STREQUAL ".json")
        set(mime "application/json; charset=utf-8")
    elseif(extension STREQUAL ".svg")
        set(mime "image/svg+xml")
    elseif(extension STREQUAL ".png")
        set(mime "image/png")
    elseif(extension STREQUAL ".jpg" OR extension STREQUAL ".jpeg")
        set(mime "image/jpeg")
    elseif(extension STREQUAL ".webp")
        set(mime "image/webp")
    elseif(extension STREQUAL ".woff2")
        set(mime "font/woff2")
    else()
        set(mime "application/octet-stream")
    endif()

    string(REPLACE "\\" "/" resource_path "${relative_path}")
    string(REPLACE "\"" "\\\"" resource_path "${resource_path}")
    string(APPEND header "        {${index}, \"${resource_path}\", \"${mime}\"},\n")
    string(APPEND resource_entries "${index} RCDATA \"${absolute_path}\"\n")
    math(EXPR index "${index} + 1")
endforeach()

string(APPEND header "    };\n")
string(APPEND header "}\n\n")
string(APPEND header "}\n")

file(WRITE "${OUTPUT_RC}" "${resource_entries}")
file(WRITE "${OUTPUT_HEADER}" "${header}")
