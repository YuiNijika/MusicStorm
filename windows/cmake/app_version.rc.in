#include <windows.h>

@KASUMI_APP_ICON_RESOURCE@
@KASUMI_TRAY_ICON_RESOURCE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KASUMI_APP_VERSION_MAJOR@,@KASUMI_APP_VERSION_MINOR@,@KASUMI_APP_VERSION_PATCH@,0
 PRODUCTVERSION @KASUMI_APP_VERSION_MAJOR@,@KASUMI_APP_VERSION_MINOR@,@KASUMI_APP_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Music Storm\0"
            VALUE "FileVersion", "@KASUMI_APP_VERSION@\0"
            VALUE "InternalName", "@KASUMI_APP_PACKAGE_NAME@\0"
            VALUE "OriginalFilename", "kasumi_app.exe\0"
            VALUE "ProductName", "Music Storm\0"
            VALUE "ProductVersion", "@KASUMI_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
